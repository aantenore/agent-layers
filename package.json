{
  "name": "agent-layers",
  "private": true,
  "type": "module",
  "description": "Composition SDK that assembles the eleven layers of an agent, from development to production",
  "license": "MIT",
  "author": "Antonio Antenore",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "runtimes/*"
  ],
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:packages": "npm test --workspaces --if-present",
    "test:layer": "node --test \"reference/$LAYER/test/**/*.test.mjs\" \"reference/$LAYER/test/**/*.test.js\"",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:adapters": "node scripts/gen-adapters-catalog.mjs",
    "release:dry": "node scripts/build-packages.mjs --clean && npm pack --dry-run --workspaces",
    "release": "node scripts/build-packages.mjs --clean && npm run typecheck && npm run test:packages && npm run docs:check && npm publish --workspaces --access public"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "reinloop": "github:aantenore/reinloop#d3b0396649d117ad0ef8ff07bd2887b2660ab48e",
    "typescript": "^7.0.2"
  }
}

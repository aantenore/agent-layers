{
  "name": "agent-layers",
  "private": true,
  "type": "module",
  "description": "Composition SDK that assembles the eleven layers of an agent, from development to production",
  "license": "MIT",
  "author": "Antonio Antenore",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "runtimes/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:packages": "npm test --workspaces --if-present",
    "test:layer": "node --test \"reference/$LAYER/test/**/*.test.mjs\" \"reference/$LAYER/test/**/*.test.js\"",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:adapters": "node scripts/gen-adapters-catalog.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "reinloop": "github:aantenore/reinloop#f02598b556009f7127382d930c0e44613ff062f8",
    "typescript": "^7.0.2"
  }
}

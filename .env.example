# Copy to .env and adjust. Every value below is a local-development default.
# Replace every "change-me" before exposing anything beyond localhost.
# Sections follow the layer ids; docs/contracts.md lists the same variables.

# Optional: use a reinloop checkout instead of the installed package
# (path to its src/index.ts; Node runs .ts natively)
# REINLOOP_SRC=/path/to/reinloop/src/index.ts

# llm (Ollama runs natively on the host; containers reach it at host.docker.internal:11434)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# harness
REINLOOP_SERVE_PORT=8700

# knowledge
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
WIKI_DIR=reference/knowledge/wiki

# tool
HTTPBIN_URL=http://localhost:8085
HTTPBIN_PORT=8085
OPENAPI_MCP_URL=http://localhost:8090/mcp
OPENAPI_MCP_PORT=8090

# identity
OIDC_ISSUER=http://localhost:8080/realms/agents
OIDC_CLIENT_ID=agent-runtime
OIDC_CLIENT_SECRET=change-me
TOOLS_AUDIENCE=tools-api
OPA_URL=http://localhost:8181
# Keycloak host port; use 18080 when 8080 is busy, and change OIDC_ISSUER to match
KEYCLOAK_PORT=8080

# guardrail
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
LLM_GUARD_URL=http://localhost:8000
LLM_GUARD_TOKEN=change-me

# cache
GATEWAY_URL=http://localhost:4000/v1
# Optional `hosted` model group of the model gateway: any provider/model LiteLLM supports. Keep values in .env only.
HOSTED_MODEL=
HOSTED_API_KEY=
# One extra request header the hosted provider may require for this key (name and value), for example its workspace id.
HOSTED_HEADER_NAME=x-agent-layers-unused
HOSTED_HEADER_VALUE=
GATEWAY_KEY=sk-local-change-me
VALKEY_URL=redis://localhost:6379

# telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
JAEGER_UI=http://localhost:16686

# eval
EVAL_DATASET=reference/eval/datasets/smoke.jsonl

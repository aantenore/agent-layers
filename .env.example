# Copy to .env and adjust. Every value below is a local-development default.
# Replace every "change-me" before exposing anything beyond localhost.

# Optional: use a reinloop checkout instead of the installed package
# (path to its src/index.ts; Node runs .ts natively)
# REINLOOP_SRC=/path/to/reinloop/src/index.ts

# L1 LLM (Ollama runs natively on the host; containers reach it at host.docker.internal:11434)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# L2 Harness
REINLOOP_SERVE_PORT=8700

# L3 Knowledge
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
WIKI_DIR=layers/l3-knowledge/wiki

# L4 Tools
HTTPBIN_URL=http://localhost:8085
OPENAPI_MCP_URL=http://localhost:8090/mcp

# L5 Identity & access
OIDC_ISSUER=http://localhost:8080/realms/agents
OIDC_CLIENT_ID=agent-runtime
OIDC_CLIENT_SECRET=change-me
TOOLS_AUDIENCE=tools-api
OPA_URL=http://localhost:8181

# L6 Guardrails
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
LLM_GUARD_URL=http://localhost:8000
LLM_GUARD_TOKEN=change-me

# L7 Cache & router
GATEWAY_URL=http://localhost:4000/v1
GATEWAY_KEY=sk-local-change-me
VALKEY_URL=redis://localhost:6379

# L8 Telemetry & observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
JAEGER_UI=http://localhost:16686

# L9 Evaluation
EVAL_DATASET=layers/l9-eval/datasets/smoke.jsonl

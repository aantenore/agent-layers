{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/contracts/eval-case.json",
  "title": "EvalCase",
  "description": "One line of a dataset JSONL file (L9).",
  "type": "object",
  "required": ["id", "input"],
  "properties": {
    "id": { "type": "string" },
    "input": { "type": "string" },
    "expected": { "description": "Reference answer or structured expectation; free-form." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "layer": {
      "enum": ["infra", "llm", "harness", "knowledge", "tool", "identity", "guardrail", "cache", "telemetry", "eval", "interface"],
      "description": "Layer the case is meant to exercise."
    }
  },
  "additionalProperties": false
}

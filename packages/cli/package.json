{
  "name": "@agent-layers/cli",
  "version": "0.1.0",
  "description": "agent-layers command line: init, dev, check, test, eval, deploy",
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agent-layers": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agent-layers/conformance": "0.1.0",
    "@agent-layers/core": "0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-basic-runtime": "0.1.0",
    "@agent-layers/adapter-compose-deploy": "0.1.0",
    "@agent-layers/adapter-console-telemetry": "0.1.0",
    "@agent-layers/adapter-expected-eval": "0.1.0",
    "@agent-layers/adapter-functions": "0.1.0",
    "@agent-layers/adapter-jsonl-telemetry": "0.1.0",
    "@agent-layers/adapter-markdown-knowledge": "0.1.0",
    "@agent-layers/adapter-memory-approval": "0.1.0",
    "@agent-layers/adapter-memory-cache": "0.1.0",
    "@agent-layers/adapter-memory-state": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-openai-compatible": "0.1.0",
    "@agent-layers/adapter-regex-guard": "0.1.0",
    "@agent-layers/adapter-rules-authorization": "0.1.0",
    "@agent-layers/adapter-static-identity": "0.1.0",
    "@agent-layers/adapter-static-router": "0.1.0",
    "@agent-layers/adapter-terminal-channel": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

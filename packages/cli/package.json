{
  "name": "@agent-layers/cli",
  "version": "0.5.0",
  "description": "agent-layers command line: init, dev, check, test, eval, deploy, gateway",
  "keywords": ["agent-layers", "cli", "agents", "scaffold", "llm", "ai-agents", "mcp", "a2a", "opentelemetry", "guardrails", "ai-gateway", "openai-compatible", "cloudevents"],
  "homepage": "https://github.com/aantenore/agent-layers/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-layers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-layers.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agent-layers": "dist/cli.js"
  },
  "exports": {
    ".": {
      "@agent-layers/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": ["dist", "templates"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-layers/source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs && node ../../scripts/pack-manifest.mjs strip",
    "postpack": "node ../../scripts/pack-manifest.mjs restore"
  },
  "dependencies": {
    "@agent-layers/conformance": "^0.5.0",
    "@agent-layers/core": "^0.5.0",
    "@agent-layers/gateway": "^0.5.0"
  },
  "devDependencies": {
    "@agent-layers/adapters": "0.5.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

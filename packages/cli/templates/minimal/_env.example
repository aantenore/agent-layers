# Copy to .env. Only the profiles named on each block need these values; prototype and test need none.

# local, pilot: a model served on this machine through an OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=

# pilot: telemetry and knowledge services (knowledge runs mcp-server-qdrant through uvx)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
QDRANT_URL=http://localhost:6333

# production: identity, authorization, guardrails, model access. State is a SQLite file
# (.agent-layers/state.db); response caching happens in the model gateway, not here.
OIDC_ISSUER=http://localhost:8080/realms/agents
OIDC_AUDIENCE=agent-runtime
OIDC_CLIENT_ID=agent-runtime
OIDC_CLIENT_SECRET=change-me
OPA_URL=http://localhost:8181
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
LLM_GUARD_URL=http://localhost:8000
GATEWAY_URL=http://localhost:4000/v1
GATEWAY_KEY=change-me

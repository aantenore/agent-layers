{
  "$schema": "./node_modules/@agent-layers/core/schema/agent-layers.schema.json",
  "name": "{{name}}",
  "profile": "prototype",
  "agents": {
    "{{agent}}": { "file": "agents/{{agent}}.md" }
  },
  "policy": [
    { "effect": "allow", "risk": ["read"] },
    { "effect": "ask", "risk": ["write"] },
    { "effect": "deny", "risk": ["exec"] }
  ],
  "pipeline": {
    "knowledge": { "k": 3, "maxChars": 3000, "mode": "system" }
  },
  "gateway": { "port": 8787 },
  "profiles": {
    "prototype": {
      "description": "Runs anywhere: zero-dependency adapters and a scripted model.",
      "tier": "prototype",
      "layers": {
        "deploy": { "adapter": "compose-deploy" },
        "model": {
          "adapter": "mock-model",
          "options": {
            "rules": [
              { "match": "(-?\\d+(?:\\.\\d+)?)\\s*(?:°\\s*)?c\\b", "tool": "convert_temperature", "args": { "celsius": "{{1}}" } }
            ]
          }
        },
        "router": { "adapter": "static-router", "options": { "model": "mock" } },
        "cache": { "adapter": "memory-cache", "options": { "maxEntries": 500 } },
        "runtime": { "adapter": "{{runtime}}" },
        "state": { "adapter": "memory-state" },
        "knowledge": {
          "docs": { "adapter": "markdown-knowledge", "options": { "dir": "knowledge" } }
        },
        "tools": {
          "util": { "adapter": "functions", "options": { "module": "./tools/convert.ts" } }
        },
        "identity": {
          "adapter": "static-identity",
          "options": { "tokens": { "dev-token": { "subject": "dev-user", "roles": ["developer"] } } }
        },
        "credentials": { "adapter": "static-identity", "options": { "default": "dev-downstream-token" } },
        "authorization": {
          "adapter": "rules-authorization",
          "options": { "rules": [{ "effect": "allow", "risk": ["read"], "when": { "authenticated": true } }], "default": "deny" }
        },
        "approval": { "adapter": "memory-approval" },
        "guardrails": [
          { "adapter": "regex-guard", "options": { "piiAction": "redact" } }
        ],
        "channels": [
          { "adapter": "terminal-channel" },
          { "adapter": "openai-compatible", "options": { "models": { "mock": "mock" } } },
          { "adapter": "mcp" },
          { "adapter": "a2a" }
        ],
        "triggers": [
          { "adapter": "cloudevents", "options": { "routes": [{ "type": "*", "agent": "{{agent}}", "input": "Event {{type}} from {{source}}: {{data}}" }] } }
        ],
        "telemetry": [{ "adapter": "console-telemetry" }],
        "eval": [{ "adapter": "expected-eval" }]
      }
    },
    "test": {
      "description": "Prototype for automated tests: telemetry to a file, no terminal channel.",
      "extends": "prototype",
      "layers": {
        "telemetry": [{ "adapter": "jsonl-telemetry", "options": { "path": ".agent-layers/telemetry.jsonl" } }],
        "channels": null
      }
    },
    "local": {
      "description": "Prototype with a real model served on this machine through an OpenAI-compatible endpoint.",
      "extends": "prototype",
      "layers": {
        "model": {
          "adapter": "openai-compatible",
          "options": { "baseUrl": "${env:LLM_BASE_URL:-http://localhost:11434/v1}", "apiKey": "${env:LLM_API_KEY:-}", "model": "${env:LLM_MODEL:-qwen3:4b}" }
        },
        "router": { "adapter": "static-router", "options": { "model": "${env:LLM_MODEL:-qwen3:4b}" } }
      }
    },
    "pilot": {
      "description": "Shared environment: telemetry to an OTLP collector; knowledge from Qdrant through its MCP server (mcp-server-qdrant over stdio, needs uv).",
      "extends": "local",
      "layers": {
        "telemetry": [{ "adapter": "otlp", "options": { "endpoint": "${env:OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4318}" } }],
        "knowledge": {
          "docs": {
            "adapter": "mcp",
            "options": {
              "command": "uvx",
              "args": ["--python", "3.12", "mcp-server-qdrant==0.8.1"],
              "env": { "QDRANT_URL": "${env:QDRANT_URL:-http://localhost:6333}", "COLLECTION_NAME": "docs", "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2" },
              "tool": "qdrant-find",
              "timeoutMs": 300000
            }
          }
        }
      }
    },
    "production": {
      "description": "Enterprise systems for identity, authorization, guardrails, state and model access. Responses are cached by the model gateway (LiteLLM with Valkey) behind openai-compatible, so no in-process cache.",
      "extends": "pilot",
      "tier": "production",
      "gateway": { "host": "0.0.0.0" },
      "layers": {
        "model": {
          "adapter": "openai-compatible",
          "options": { "baseUrl": "${env:GATEWAY_URL:-http://localhost:4000/v1}", "apiKey": "${env:GATEWAY_KEY:-}", "model": "default" }
        },
        "router": null,
        "cache": null,
        "runtime": { "adapter": "reinloop" },
        "state": { "adapter": "sqlite-state", "options": { "path": ".agent-layers/state.db" } },
        "identity": { "adapter": "oidc", "options": { "issuer": "${env:OIDC_ISSUER:-http://localhost:8080/realms/agents}", "audience": "${env:OIDC_AUDIENCE:-agent-runtime}" } },
        "credentials": {
          "adapter": "oidc",
          "options": { "issuer": "${env:OIDC_ISSUER:-http://localhost:8080/realms/agents}", "clientId": "${env:OIDC_CLIENT_ID:-agent-runtime}", "clientSecret": "${env:OIDC_CLIENT_SECRET}", "mode": "on-behalf-of" }
        },
        "authorization": { "adapter": "opa", "options": { "url": "${env:OPA_URL:-http://localhost:8181}" } },
        "approval": null,
        "guardrails": [
          { "adapter": "presidio", "options": { "analyzerUrl": "${env:PRESIDIO_ANALYZER_URL:-http://localhost:5002}", "anonymizerUrl": "${env:PRESIDIO_ANONYMIZER_URL:-http://localhost:5001}", "entities": ["EMAIL_ADDRESS", "PHONE_NUMBER", "CREDIT_CARD", "IBAN_CODE", "US_SSN", "IP_ADDRESS"] } },
          { "adapter": "llm-guard", "options": { "url": "${env:LLM_GUARD_URL:-http://localhost:8000}" } }
        ],
        "channels": [
          { "adapter": "openai-compatible", "options": { "models": { "default": "default" } } },
          { "adapter": "mcp" },
          { "adapter": "a2a" }
        ]
      }
    }
  }
}

{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "agent-layers dev",
    "check": "agent-layers check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:live": "node --test \"tests/**/*.test.ts\"",
    "test:stack": "agent-layers test",
    "eval": "agent-layers eval evals/smoke.jsonl --agent {{agent}}",
    "layers": "agent-layers layers",
    "diff": "agent-layers diff",
    "gateway": "agent-layers gateway",
    "deploy": "agent-layers deploy --profile production"
  },
  "dependencies": {
    "@agent-layers/core": "^{{version}}",
    "@agent-layers/adapters": "^{{version}}",
    "reinloop": "^0.4.0"
  },
  "devDependencies": {
    "@agent-layers/cli": "^{{version}}"
  }
}

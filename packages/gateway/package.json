{
  "name": "@agent-layers/gateway",
  "version": "0.1.0",
  "description": "Network host for a composed agent-layers stack: inbound standards, identity, limits and access logs in one place",
  "keywords": ["agent-layers", "gateway", "agents", "http"],
  "homepage": "https://github.com/aantenore/agent-layers/tree/main/packages/gateway#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-layers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-layers.git",
    "directory": "packages/gateway"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@agent-layers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-layers/source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@agent-layers/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-basic-runtime": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-static-identity": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

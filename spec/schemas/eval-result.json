{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/eval-result.json",
  "title": "EvalResult",
  "description": "One line of an evaluation result file, JSON Lines (layer eval).",
  "type": "object",
  "required": ["id", "runId", "output", "status", "scores"],
  "properties": {
    "id": { "type": "string", "description": "EvalCase id." },
    "runId": { "type": "string" },
    "output": { "type": "string" },
    "status": { "$ref": "common.json#/$defs/RunStatus" },
    "scores": { "type": "array", "items": { "$ref": "#/$defs/EvalScore" } },
    "reason": { "$ref": "common.json#/$defs/StopReason" },
    "usage": { "$ref": "common.json#/$defs/Usage" },
    "costUsd": {
      "type": "number",
      "minimum": 0,
      "description": "Cost of the run in US dollars, as the run reported it."
    },
    "ext": { "$ref": "common.json#/$defs/Ext" }
  },
  "additionalProperties": false,
  "$defs": {
    "EvalScore": {
      "type": "object",
      "required": ["metric", "value"],
      "properties": {
        "metric": { "type": "string" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "layer": { "$ref": "common.json#/$defs/Layer" },
        "reason": { "type": "string" },
        "ext": { "$ref": "common.json#/$defs/Ext" }
      },
      "additionalProperties": false,
      "description": "One metric of one run. value in [0, 1]."
    }
  },
  "examples": [
    {
      "id": "refund-window",
      "runId": "run_02",
      "output": "Refunds take 14 days.",
      "status": "completed",
      "scores": [{ "metric": "correctness", "value": 1, "layer": "knowledge" }],
      "usage": { "inputTokens": 412, "outputTokens": 58 },
      "costUsd": 0.0009
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/eval-result.json",
  "title": "EvalResult",
  "description": "One line of an evaluation result file, JSON Lines (layer eval).",
  "type": "object",
  "required": ["id", "runId", "output", "status", "scores"],
  "properties": {
    "id": { "type": "string", "description": "EvalCase id." },
    "runId": { "type": "string" },
    "output": { "type": "string" },
    "status": { "type": "string", "description": "Run status as reported by the harness, e.g. completed, failed, stopped." },
    "scores": { "type": "array", "items": { "$ref": "#/$defs/EvalScore" } },
    "usage": { "$ref": "chat-response.json#/properties/usage" },
    "costUsd": { "type": "number", "minimum": 0, "description": "Cost of the run in US dollars, as the run reported it." }
  },
  "$defs": {
    "EvalScore": {
      "type": "object",
      "required": ["metric", "value"],
      "properties": {
        "metric": { "type": "string" },
        "value": { "type": "number" },
        "layer": { "enum": ["infra", "llm", "cache", "harness", "knowledge", "tool", "identity", "guardrail", "interface", "telemetry", "eval"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

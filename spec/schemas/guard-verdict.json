{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/guard-verdict.json",
  "title": "GuardVerdict",
  "description": "Result of GuardPort.check (layer guardrail).",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": { "enum": ["allow", "block", "redact"] },
    "text": { "type": "string", "description": "Redacted text; required when action is redact." },
    "reason": { "type": "string" }
  },
  "if": { "properties": { "action": { "const": "redact" } } },
  "then": { "required": ["action", "text"] },
  "additionalProperties": false
}

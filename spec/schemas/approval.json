{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/approval.json",
  "title": "Approval",
  "description": "Human approval of an action the policy marks ask (layer identity, ApprovalPort).",
  "type": "object",
  "required": ["id", "status", "request"],
  "properties": {
    "id": { "type": "string" },
    "status": { "$ref": "common.json#/$defs/ApprovalStatus" },
    "request": { "$ref": "#/$defs/ApprovalRequest" },
    "decidedBy": { "type": "string" },
    "reason": { "type": "string" },
    "ext": { "$ref": "common.json#/$defs/Ext" }
  },
  "additionalProperties": false,
  "$defs": {
    "ApprovalRequest": {
      "type": "object",
      "required": ["question", "agent", "runId"],
      "properties": {
        "question": { "$ref": "access-question.json" },
        "agent": { "type": "string" },
        "runId": { "type": "string" },
        "reason": { "type": "string" },
        "expiresAt": {
          "$ref": "common.json#/$defs/Time",
          "description": "After this time a pending approval becomes expired."
        },
        "key": {
          "type": "string",
          "description": "Identifies the call being approved (session, caller, access question with arguments), so a later identical call finds the decision. Since ApprovalPort 1.1.0."
        },
        "ext": { "$ref": "common.json#/$defs/Ext" }
      },
      "additionalProperties": false,
      "description": "What is being asked, by which run."
    }
  },
  "examples": [
    {
      "id": "apr_01",
      "status": "pending",
      "request": {
        "question": {
          "caller": {
            "id": "u-1042",
            "kind": "user",
            "roles": ["support"],
            "scopes": ["orders:read"],
            "name": "Mara Rossi"
          },
          "action": "call",
          "target": {
            "kind": "tool",
            "id": "crm__delete",
            "layer": "tool",
            "risk": "exec",
            "agent": "support",
            "attrs": { "owner": "sales" }
          },
          "args": { "customer": "C-77" }
        },
        "agent": "support",
        "runId": "run_03",
        "reason": "exec tools need a person",
        "expiresAt": "2026-10-31T11:00:00Z"
      }
    }
  ]
}

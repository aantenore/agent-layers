{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/eval-case.json",
  "title": "EvalCase",
  "description": "One line of an evaluation dataset, JSON Lines (layer eval).",
  "type": "object",
  "required": ["id", "input"],
  "properties": {
    "id": { "type": "string" },
    "input": { "$ref": "common.json#/$defs/RunInput" },
    "expected": {},
    "tags": { "type": "array", "items": { "type": "string" } },
    "layer": { "$ref": "common.json#/$defs/Layer" },
    "ext": { "$ref": "common.json#/$defs/Ext" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "refund-window",
      "input": "How long do refunds take?",
      "expected": "14 days",
      "tags": ["faq"],
      "layer": "knowledge"
    }
  ]
}

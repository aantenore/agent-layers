{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/access-request.json",
  "title": "AccessRequest",
  "description": "Authorization request: subject, action, resource, context (layer identity, AuthorizationPort).",
  "type": "object",
  "required": ["subject", "action", "resource"],
  "properties": {
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "agent", "anonymous"], "description": "user or agent for a verified identity; anonymous when the call carries none." },
        "id": { "type": "string", "description": "Identity subject, or anonymous." },
        "properties": {
          "type": "object",
          "properties": {
            "roles": { "type": "array", "items": { "type": "string" } },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "authenticated": { "type": "boolean", "description": "true for a verified identity, false for an anonymous subject." }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "examples": ["call"] },
        "properties": { "type": "object" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "examples": ["tool"] },
        "id": { "type": "string", "description": "Tool name." },
        "properties": {
          "type": "object",
          "properties": {
            "risk": { "enum": ["read", "write", "exec"] },
            "agent": { "type": "string" },
            "layer": { "type": "string", "description": "Layer of the resource, e.g. tool or knowledge." }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "args": { "description": "Arguments of the tool call." }
      }
    }
  }
}

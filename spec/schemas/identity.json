{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/identity.json",
  "title": "Identity",
  "description": "Who a run acts as (layer identity). The raw token is never serialised.",
  "type": "object",
  "required": ["subject", "kind"],
  "properties": {
    "subject": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["user", "agent"] },
    "roles": { "type": "array", "items": { "type": "string" } },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "claims": { "type": "object" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/tool-spec.json",
  "title": "ToolSpec",
  "description": "A tool an agent may call (layer tool, ToolPort.listTools).",
  "type": "object",
  "required": ["name", "description", "params"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "description": "Prefixed <source>__<tool> by the core."
    },
    "description": { "type": "string" },
    "params": { "type": "object", "description": "JSON Schema of the arguments object." },
    "risk": { "$ref": "common.json#/$defs/Risk" },
    "layer": { "$ref": "common.json#/$defs/Layer" },
    "audience": {
      "type": "string",
      "description": "Credential audience of the protected service the tool calls."
    },
    "attrs": { "$ref": "common.json#/$defs/Attrs" },
    "ext": { "$ref": "common.json#/$defs/Ext" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "crm__lookup",
      "description": "Look up a customer by id.",
      "params": {
        "type": "object",
        "required": ["customer"],
        "properties": { "customer": { "type": "string" } }
      },
      "risk": "read",
      "audience": "crm-api",
      "attrs": { "owner": "sales" },
      "ext": { "mcp.annotations": { "readOnlyHint": true } }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aantenore/agent-layers/spec/schemas/tool-spec.json",
  "title": "ToolSpec",
  "description": "A tool as listed by ToolPort.listTools (layer tool).",
  "type": "object",
  "required": ["name", "description", "inputSchema"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "description": { "type": "string" },
    "inputSchema": { "type": "object", "description": "JSON Schema of the arguments object." },
    "layer": { "enum": ["infra", "llm", "cache", "harness", "knowledge", "tool", "identity", "guardrail", "interface", "telemetry", "eval"] },
    "risk": { "enum": ["read", "write", "exec"], "description": "Missing risk is treated as exec." },
    "audience": { "type": "string", "description": "Audience a credential is needed for." },
    "meta": { "type": "object" }
  }
}

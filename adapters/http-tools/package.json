{
  "name": "@agent-layers/adapter-http-tools",
  "version": "0.1.0",
  "description": "Tool adapter that turns declarative HTTP/JSON requests into tools",
  "keywords": ["agent-layers", "agent-layers-adapter"],
  "homepage": "https://github.com/aantenore/agent-layers/tree/main/adapters/http-tools#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-layers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-layers.git",
    "directory": "adapters/http-tools"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "agentLayers": {
    "maturity": "experimental"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@agent-layers/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-basic-runtime": "0.1.0",
    "@agent-layers/adapter-mcp": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-openapi": "0.1.0",
    "@agent-layers/conformance": "0.1.0",
    "@agent-layers/core": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@agent-layers/adapter-a2a",
  "version": "0.1.0",
  "description": "Agent2Agent (A2A) protocol: the stack's agents served to other agents, and remote A2A agents as runtimes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "keywords": ["agent-layers", "agent-layers-adapter"],
  "agentLayers": {
    "maturity": "experimental"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@agent-layers/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-basic-runtime": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-static-identity": "0.1.0",
    "@agent-layers/conformance": "0.1.0",
    "@agent-layers/core": "0.1.0",
    "@agent-layers/gateway": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

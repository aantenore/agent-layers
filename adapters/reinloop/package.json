{
  "name": "@agent-layers/adapter-reinloop",
  "version": "0.1.0",
  "description": "reinloop agent runtime as an agent-layers RuntimePort",
  "keywords": ["agent-layers", "agent-layers-adapter", "reinloop"],
  "homepage": "https://github.com/aantenore/agent-layers/tree/main/adapters/reinloop#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-layers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-layers.git",
    "directory": "adapters/reinloop"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "reinloop": "github:aantenore/reinloop#d3b0396649d117ad0ef8ff07bd2887b2660ab48e"
  },
  "peerDependencies": {
    "@agent-layers/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-functions": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-openai-compatible": "0.1.0",
    "@agent-layers/adapter-regex-guard": "0.1.0",
    "@agent-layers/conformance": "0.1.0",
    "@agent-layers/core": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

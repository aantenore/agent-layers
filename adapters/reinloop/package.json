{
  "name": "@agent-layers/adapter-reinloop",
  "version": "0.1.0",
  "description": "reinloop agent runtime as an agent-layers RuntimePort",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "agent-layers",
    "agent-layers-adapter",
    "reinloop"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "reinloop": "github:aantenore/reinloop#f02598b556009f7127382d930c0e44613ff062f8"
  },
  "peerDependencies": {
    "@agent-layers/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-functions": "0.1.0",
    "@agent-layers/adapter-mock-model": "0.1.0",
    "@agent-layers/adapter-openai-compatible": "0.1.0",
    "@agent-layers/adapter-regex-guard": "0.1.0",
    "@agent-layers/conformance": "0.1.0",
    "@agent-layers/core": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

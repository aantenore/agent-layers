{
  "name": "agent-layers-adapter-template",
  "version": "0.4.0",
  "description": "Copyable skeleton of an agent-layers adapter, in its own package or in packages/adapters",
  "keywords": ["agent-layers", "agent-layers-adapter"],
  "homepage": "https://github.com/aantenore/agent-layers/tree/main/adapters/_template#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-layers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-layers.git",
    "directory": "examples/adapter-package"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@agent-layers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-layers/source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@agent-layers/core": "^0.4.0"
  },
  "devDependencies": {
    "@agent-layers/conformance": "0.4.0",
    "@agent-layers/core": "0.4.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}

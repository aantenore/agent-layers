# Copy to .env. Only the profiles named on each block need these values; prototype and test need none.

# local, pilot: a model served on this machine through an OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=

# polyglot: the Python agent that runs the agent over A2A, and the telemetry file of the gateway
A2A_AGENT_URL=http://localhost:9100
POLYGLOT_TELEMETRY_PATH=.agent-layers/polyglot-telemetry.jsonl

# pilot: telemetry and knowledge services (knowledge runs mcp-server-qdrant through uvx)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
QDRANT_URL=http://localhost:6333

# production: identity, authorization, guardrails, model access. State is a SQLite file
# (.agent-layers/state.db); response caching happens in the model gateway, not here.
OIDC_ISSUER=http://localhost:8080/realms/agents
OIDC_AUDIENCE=agent-runtime
OIDC_CLIENT_ID=agent-runtime
OIDC_CLIENT_SECRET=change-me
OPA_URL=http://localhost:8181
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001
LLM_GUARD_URL=http://localhost:8000
LLM_GUARD_TOKEN=change-me
GATEWAY_URL=http://localhost:4000/v1
GATEWAY_KEY=change-me
# production gateway: the public address clients reach (the A2A agent card advertises it); the gateway listens
# on 0.0.0.0, so set it to the load balancer or DNS name in front of it. GATEWAY_URL above is the model gateway.
GATEWAY_PUBLIC_ORIGIN=http://localhost:8787
# production: key of the session-id digest. Generate one, never commit it: openssl rand -hex 32
SESSION_SECRET=
# production: run budget and the tool time limit of the reinloop runtime (defaults shown)
RUN_MAX_TOKENS=200000
RUN_MAX_COST_USD=5
TOOL_TIMEOUT_MS=60000
